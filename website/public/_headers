# Response headers for hosts that read this file (Cloudflare Pages, Netlify),
# with the site served from "/".
#
# The site's own host is GitHub Pages (.github/workflows/website.yml), which
# sends no custom headers and ignores this file (the workflow leaves it out).
# There each page carries the same Content-Security-Policy in a
# <meta http-equiv> tag, and its referrer policy in <meta name="referrer">.
# A page cannot set the rest: on GitHub Pages there is no X-Frame-Options,
# frame-ancestors, X-Content-Type-Options or Permissions-Policy, and the
# island demo under /island/ has no policy of its own, so other sites can
# frame it. It is a simulation that cannot approve anything.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The live demo is the app's island, framed by the site's own pages. It sets
# style attributes as it draws, and here it may only be framed from this site.
/island/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'self'

/island/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/shots/*
  Cache-Control: public, max-age=604800

/*.css
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=86400
