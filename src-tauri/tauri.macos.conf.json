{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": { "../target/release/nobetci-hook": "nobetci-hook" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 196 },
        "applicationFolderPosition": { "x": 480, "y": 196 }
      }
    }
  }
}
